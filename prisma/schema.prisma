  timeTrackingEnabled             Boolean  @default(true)
  tasksEnabled                    Boolean  @default(true)
  payrollEnabled                  Boolean  @default(true)
  inventoryEnabled                Boolean  @default(true)
  warehousesEnabled               Boolean  @default(true)
  batchTrackingEnabled            Boolean  @default(true)
