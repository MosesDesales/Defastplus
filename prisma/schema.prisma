generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum CreditNoteStatus {
  DRAFT
  OPEN
  APPLIED
  CLOSED
}

/// Credit / adjustment against customer balance (optionally linked to a reference invoice)

enum CustomerType {
  BUSINESS
  INDIVIDUAL
}

enum GstTaxPreference {
  TAXABLE
  NON_TAXABLE
  EXEMPT
  NIL_RATED
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
}

enum IntegrationType {
  TALLY
  ZOHO_BOOKS
  QUICKBOOKS
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  VOID
}

enum ItemGstTaxMode {
  AUTO
  INTRA
  INTER
}

enum ItemType {
  GOODS
  SERVICE
}

enum JournalPostingStatus {
  DRAFT
  POSTED
}

enum JournalReferenceKind {
  INVOICE_ISSUE
  PAYMENT_RECEIPT
  CREDIT_NOTE
  MANUAL
  PURCHASE_EXPENSE
  VENDOR_BILL
  VENDOR_PAYMENT
  VENDOR_CREDIT
  PAYROLL_RUN
  TALLY_IMPORT
}

enum TallyMigrationStatus {
  PENDING
  PARSING
  IMPORTING_COA
  IMPORTING_VOUCHERS
  IMPORTING_INVENTORY
  RECONCILING
  COMPLETED
  FAILED
  PARTIAL
}

enum PaymentMode {
  CASH
  BANK
  UPI
  CARD
  OTHER
}

enum PayrollRunStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  RECEIVED
  BILLED
  CANCELLED
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurringInvoiceStatus {
  ACTIVE
  PAUSED
  STOPPED
}

enum SalaryAmountType {
  FLAT
  PERCENT_OF_BASIC
}

enum SalaryComponentKind {
  EARNING
  DEDUCTION
}

enum TeamMemberStatus {
  INVITED
  ACTIVE
  INACTIVE
}

enum ValuationMethod {
  FIFO
  WEIGHTED_AVERAGE
}

enum VendorBillStatus {
  DRAFT
  UNPAID
  PARTIALLY_PAID
  PAID
  VOID
}

enum EWayBillStatus {
  DRAFT
  READY
  GENERATED
  IN_TRANSIT
  EXPIRED
  CANCELLED
  ERROR
}

enum EWayBillDocumentType {
  TAX_INVOICE
  BILL_OF_SUPPLY
  DELIVERY_CHALLAN
  JOB_WORK_CHALLAN
  STOCK_TRANSFER
  PURCHASE_RETURN
  EXPORT_SHIPMENT
}

enum EWayTransportMode {
  ROAD
  RAIL
  AIR
  SHIP
}

enum EWayVehicleType {
  REGULAR
  OVER_DIMENSIONAL_CARGO
}

enum DeliveryChallanStatus {
  DRAFT
  DISPATCHED
  DELIVERED
  VOID
}

enum PurchaseReturnStatus {
  DRAFT
  DISPATCHED
  COMPLETED
  VOID
}

enum VendorCreditStatus {
  OPEN
  CLOSED
}

model Account {
  id     String      @id @default(cuid())
  userId String
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  code   String
  name   String
  type   AccountType
  /// System-provided default accounts (Bank, AR, Sales, GST output)
  isSystem Boolean @default(false)

  parentId String?
  parent   Account?  @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Account[] @relation("AccountHierarchy")

  openingBalance Decimal @default(0)
  description    String?
  isActive       Boolean @default(true)
  /// Tally migration — preserve Tally GUID and group vs ledger distinction
  tallyGuid        String?
  tallyParentName  String?
  isTallyGroup     Boolean @default(false)

  journalLines JournalLine[]

  purchaseExpenseDr          PurchaseExpense[]        @relation("PurchaseExpenseExpenseAccount")
  purchaseExpenseCr          PurchaseExpense[]        @relation("PurchaseExpenseBankAccount")
  recurringExpenseDr         RecurringExpense[]       @relation("RecurringExpenseExpenseAccount")
  recurringExpenseCr         RecurringExpense[]       @relation("RecurringExpenseBankAccount")
  vendorBillLineExpense      VendorBillLine[]         @relation("VendorBillLineExpense")
  vendorPaymentBank          VendorPayment[]          @relation("VendorPaymentBankAccount")
  vendorCreditExpense        VendorCredit[]           @relation("VendorCreditExpenseAccount")
  recurringVendorBillExpense RecurringVendorBillLine[] @relation("RecurringVendorBillLineExpense")
  vendorAccountsPayable      Vendor[]                  @relation("VendorAccountsPayable")
  vendorTds                  Vendor[]                  @relation("VendorTdsAccount")
  purchaseOrderLineExpense   PurchaseOrderLine[]       @relation("POLineExpense")
  vendorBillAccountsPayable      VendorBill[]              @relation("VendorBillAP")
  recurringVendorBillAccountsPayable RecurringVendorBill[] @relation("RecurringVendorBillAP")

  bankingChartAccounts           BankingAccount[] @relation("BankingChartAccount")
  fixedAssetAssetAccounts        FixedAsset[]     @relation("FixedAsset_assetAccountIdToAccount")
  fixedAssetDepExpenseAccounts   FixedAsset[]     @relation("FixedAsset_depreciationExpenseAccountIdToAccount")
  fixedAssetAccumDepAccounts     FixedAsset[]     @relation("FixedAsset_accumulatedDepreciationAccountIdToAccount")
  fixedAssetDisposalCashAccounts FixedAsset[]     @relation("FixedAsset_disposalCashAccountIdToAccount")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, code])
  @@index([userId])
  @@index([parentId])
  @@index([userId, tallyGuid])
}

model AppRole {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  slug        String
  permissions Json
  isSystem    Boolean @default(false)

  teamMembers TeamMember[]

  @@unique([userId, slug])
  @@index([userId])
}

model AuditLog {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  action   String
  entity   String
  entityId String?
  meta     Json?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model BankStatementImport {
  id                 String               @id @default(cuid())
  userId             String
  bankingAccountId   String
  fileName           String
  fileHash           String
  format             String
  rowCount           Int                  @default(0)
  importedAt         DateTime             @default(now())
  duplicateHint      String?
  fileMime           String?
  fileSizeBytes      Int?
  bankingAccount     BankingAccount       @relation(fields: [bankingAccountId], references: [id], onDelete: Cascade)
  transactions BankingTransaction[]

  @@unique([bankingAccountId, fileHash])
  @@index([userId])
}

model BankingAccount {
  id                  String                @id @default(cuid())
  userId              String
  bankName            String
  accountName         String
  accountNumber       String
  routingOrIfsc       String?
  currency            String                @default("INR")
  kind                String
  status              String                @default("ACTIVE")
  openingBalance      Decimal               @default(0)
  openingBalanceDate  DateTime?
  chartAccountId      String?
  lastSyncedAt        DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  statementImports BankStatementImport[]
  chartAccount             Account?              @relation("BankingChartAccount", fields: [chartAccountId], references: [id])
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  BankingTransaction[]

  @@index([chartAccountId])
  @@index([userId])
}

model BankingTransaction {
  id                        String                      @id @default(cuid())
  userId                    String
  bankingAccountId          String
  statementImportId         String?
  txnDate                   DateTime
  description               String
  reference                 String?
  debit                     Decimal                     @default(0)
  credit                    Decimal                     @default(0)
  balance                   Decimal?
  status                    String                      @default("UNMAPPED")
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  sourceFingerprint         String?
  statementImport       BankStatementImport?        @relation(fields: [statementImportId], references: [id])
  bankingAccount            BankingAccount              @relation(fields: [bankingAccountId], references: [id], onDelete: Cascade)
  mappings BankingTransactionMapping[]

  @@index([bankingAccountId, sourceFingerprint])
  @@index([userId, status])
  @@index([bankingAccountId, txnDate])
}

model BankingTransactionMapping {
  id                     String             @id
  bankingTransactionId   String
  moduleType             String
  moduleId               String
  amountApplied          Decimal
  createdPaymentId       String?
  createdVendorPaymentId String?
  createdExpenseId       String?
  createdAt              DateTime           @default(now())
  transaction     BankingTransaction @relation(fields: [bankingTransactionId], references: [id], onDelete: Cascade)

  @@index([moduleType, moduleId])
  @@index([bankingTransactionId])
}

model CompanyProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName   String?
  logoUrl       String?
  billingStreet String?
  billingStreet2 String?
  billingCity   String?
  billingState  String?
  billingZip    String?
  billingCountry String @default("IN")
  gstin         String?
  pan           String?
  companyIdentifier String?
  financialYearStartMonth Int @default(4)
  currency      String @default("INR")

  industry    String?
  phone       String?
  fax         String?
  websiteUrl  String?

  paymentAddressDifferent Boolean @default(false)
  paymentStreet   String?
  paymentStreet2  String?
  paymentCity     String?
  paymentState    String?
  paymentZip      String?

  contactName  String?
  contactEmail String?

  smtpEnabled Boolean @default(false)
  smtpHost    String?
  smtpPort    Int?

  reportBasis String @default("ACCRUAL")
  timezone    String @default("Asia/Kolkata")
  dateFormat  String @default("dd/MM/yyyy")

  organizationLanguage     String @default("en")
  communicationLanguages   String @default("en")

  addressFormatNote String?
  prefWeekStartsMonday Boolean @default(true)

  /// Settings → Taxes → GST (India)
  gstRegistered              Boolean   @default(true)
  gstRegistrationType        String?
  gstBusinessLegalName       String?
  gstBusinessTradeName       String?
  gstRegisteredOn            DateTime?
  gstReverseChargeSales      Boolean   @default(false)
  gstSezOverseasTrading      Boolean   @default(false)
  gstDigitalServicesExport   Boolean   @default(false)

  updatedAt DateTime @updatedAt
}

model CreditNote {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  creditNumber String
  issueDate    DateTime
  status       CreditNoteStatus @default(DRAFT)

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  reason        String?
  subTotal      Decimal @default(0)
  taxTotal      Decimal @default(0)
  total         Decimal @default(0)
  amountApplied Decimal @default(0)

  lines         CreditNoteLine[]
  applications  CreditNoteApplication[]

  reversalJournalId String?       @unique
  reversalJournal   JournalEntry? @relation("CreditNoteJournal", fields: [reversalJournalId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, creditNumber])
  @@index([userId])
  @@index([customerId])
  @@index([invoiceId])
}

model CreditNoteApplication {
  id           String     @id @default(cuid())
  creditNoteId String
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  invoiceId    String
  invoice      Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount       Decimal

  createdAt DateTime @default(now())

  @@index([creditNoteId])
  @@index([invoiceId])
}

// ---- GST / HR / Settings (India SaaS modules) ----

model CreditNoteLine {
  id           String     @id @default(cuid())
  creditNoteId String
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  itemId String?
  item   Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  description String
  quantity    Decimal
  rate        Decimal
  taxPercent  Decimal @default(0)

  lineNet   Decimal
  lineTax   Decimal
  lineTotal Decimal

  lineCgst Decimal @default(0)
  lineSgst Decimal @default(0)
  lineIgst Decimal @default(0)

  sortOrder Int @default(0)

  @@index([creditNoteId])
}

model Currency {
  id             String    @id @default(cuid())
  userId         String
  code           String
  symbol         String
  name           String
  decimalPlaces  Int       @default(2)
  formatLocale   String    @default("en-IN")
  isBaseCurrency Boolean   @default(false)
  exchangeRate   Decimal?
  rateUpdatedAt  DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@index([userId, isActive])
  @@index([userId])
}

model Customer {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  customerType CustomerType @default(BUSINESS)

  salutation    String?
  firstName     String?
  lastName      String?
  companyName   String?
  displayName   String
  gstin         String?
  email         String?
  workPhoneCountryCode String @default("+91")
  workPhone            String?
  mobileCountryCode    String @default("+91")
  mobile               String?
  customerLanguage     String   @default("en")

  billingAttention String?
  billingStreet    String?
  billingCity      String?
  billingState     String?
  billingZip       String?
  billingCountry   String @default("IN")

  pan                       String?
  currency                  String  @default("INR")
  accountsReceivableAccount String?
  openingBalance            Decimal @default(0)
  paymentTerms              String  @default("DUE_ON_RECEIPT")

  portalEnabled Boolean @default(false)
  remarks       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes    Quote[]
  invoices  Invoice[]
  ewayBills EWayBill[]
  deliveryChallans DeliveryChallan[]
  payments  Payment[]
  creditNotes       CreditNote[]
  recurringInvoices RecurringInvoice[]
  purchaseExpenses PurchaseExpense[]
  recurringExpenseTemplates RecurringExpense[]
  purchaseOrdersDeliverTo PurchaseOrder[] @relation("PODeliveryCustomer")
  vendorBillLines           VendorBillLine[]
  recurringVendorBillLines  RecurringVendorBillLine[]
  timeProjects              TimeProject[]
  workTasks                 WorkTask[]

  @@index([userId])
  @@index([userId, displayName])
}

model DepreciationEntry {
  id               String       @id
  assetId          String
  periodStart      DateTime
  amount           Decimal
  openingBookValue Decimal
  closingBookValue Decimal
  journalEntryId   String       @unique
  journalEntry     JournalEntry @relation(fields: [journalEntryId], references: [id])
  asset       FixedAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, periodStart])
  @@index([assetId])
}

model DocumentTemplate {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type       String
  name       String
  isDefault  Boolean @default(false)
  configJson String

  thumbnailUrl            String?
  exportFileNamePattern   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]
  moduleMaps   DocumentTemplateModuleMap[]
  userDefaults UserDocumentTemplateDefault[]

  @@index([userId, type])
  @@index([userId, type, isDefault])
}

model DocumentTemplateModuleMap {
  id         String @id @default(cuid())
  templateId String
  moduleName String
  template DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, moduleName])
  @@index([moduleName])
}

model Employee {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  employeeNumber String
  displayName    String
  email          String?
  phone          String?
  department     String?
  designation    String?
  dateOfJoining  DateTime?

  salaryStructureId String?
  salaryStructure   SalaryStructure? @relation(fields: [salaryStructureId], references: [id], onDelete: SetNull)

  bankAccountName String?
  bankIfsc        String?
  bankAccountNo   String?
  pan             String?
  aadhaarLast4    String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payslips Payslip[]
  timeProjectMembers   TimeProjectMember[]
  assignedTimeTasks    TimeTask[]           @relation("TimeTaskAssignee")
  assignedWorkTasks    WorkTask[]           @relation("WorkTaskAssignee")
  timeEntries          TimeEntry[]
  timesheets           Timesheet[]
  leaveEntries         LeaveEntry[]

  @@unique([userId, employeeNumber])
  @@index([userId])
}

/// A category of leave (Sick Leave, Casual Leave, ...) with a fixed annual quota.
model LeaveType {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  annualDays  Decimal @default(0)
  isLossOfPay Boolean @default(false)
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  entries LeaveEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

/// A recorded leave taken by an employee on a given date.
model LeaveEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  date  DateTime
  days  Decimal  @default(1)
  notes String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([employeeId])
  @@index([leaveTypeId])
}

model FixedAsset {
  id                                                           String              @id
  userId                                                       String
  name                                                         String
  assetCode                                                    String
  category                                                     String?
  purchaseDate                                                 DateTime
  purchaseCost                                                 Decimal
  salvageValue                                                 Decimal             @default(0)
  usefulLifeYears                                              Int
  depreciationMethod                                           String
  wdvAnnualPercent                                             Decimal?
  depreciationStartDate                                        DateTime
  scheduleFrequency                                            String              @default("MONTHLY")
  assetAccountId                                               String
  depreciationExpenseAccountId                                 String
  accumulatedDepreciationAccountId                             String
  accumulatedDepreciation                                      Decimal             @default(0)
  currentBookValue                                             Decimal
  status                                                       String              @default("ACTIVE")
  disposedAt                                                   DateTime?
  disposalType                                                 String?
  disposalProceeds                                             Decimal?
  disposalGainOrLoss                                           Decimal?
  disposalCashAccountId                                        String?
  disposalJournalId                                            String?             @unique
  createdAt                                                    DateTime            @default(now())
  updatedAt                                                    DateTime
  depreciationEntries                                            DepreciationEntry[]
  disposalJournal                                                 JournalEntry?       @relation("FixedAssetDisposalJournal", fields: [disposalJournalId], references: [id])
  disposalCashAccount            Account?            @relation("FixedAsset_disposalCashAccountIdToAccount", fields: [disposalCashAccountId], references: [id])
  accumulatedDepreciationAccount Account             @relation("FixedAsset_accumulatedDepreciationAccountIdToAccount", fields: [accumulatedDepreciationAccountId], references: [id])
  depreciationExpenseAccount     Account             @relation("FixedAsset_depreciationExpenseAccountIdToAccount", fields: [depreciationExpenseAccountId], references: [id])
  assetAccount                   Account             @relation("FixedAsset_assetAccountIdToAccount", fields: [assetAccountId], references: [id])
  user                                                         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, assetCode])
  @@index([userId, status])
  @@index([userId])
}

model GstBillReconciliation {
  id String @id @default(cuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  billId String @unique
  bill   VendorBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  monthKey String
  status   String @default("PENDING")

  portalInvoiceNo String?
  notes           String?

  @@index([userId, monthKey])
}

model Integration {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type                   IntegrationType
  status                 IntegrationStatus @default(DISCONNECTED)
  /// AES-GCM encrypted JSON (client secrets, tokens, Tally bridge secrets)
  credentialsEncrypted   String?
  /// Non-secret JSON: sync scopes, Tally base URL, OAuth redirect, etc.
  configJson             String?
  /// Account / tax / item mapping: { accounts: [], taxRates: [], items: [] }
  mappingJson            String?
  lastSyncAt             DateTime?
  autoSync               Boolean             @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  syncLogs SyncLog[]
  tallyMigrationJobs TallyMigrationJob[]

  @@unique([userId, type])
  @@index([userId])
}

model InventorySettings {
  userId            String          @id
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  valuationMethod   ValuationMethod @default(WEIGHTED_AVERAGE)
}

model InventoryUnit {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  abbreviation String   @default("")
  items        Item[]
  createdAt    DateTime @default(now())

  @@unique([userId, name])
  @@index([userId])
}

model Invoice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  invoiceNumber String
  reference     String?
  issueDate     DateTime
  dueDate       DateTime?

  status   InvoiceStatus @default(DRAFT)
  currency String        @default("INR")
  /// Snapshot: 1 unit of `currency` → base currency (null when currency is base).
  exchangeRate Decimal?
  /// Payable total converted to organization base currency at save time.
  baseTotal    Decimal?

  subTotal Decimal @default(0)
  taxTotal Decimal @default(0)
  total    Decimal @default(0)

  /// Document-level discount % on ex-tax line sum (0–100).
  discountPercent Decimal @default(0)
  /// NONE | TDS | TCS — withholding on amount after discount + scaled tax.
  withholdingType     String  @default("NONE")
  withholdingPercent  Decimal @default(0)
  adjustmentLabel     String  @default("Adjustment")
  adjustmentAmount    Decimal @default(0)
  /// Amount due after discount, withholding, and adjustment (shown on PDF / preview).
  payableTotal Decimal @default(0)

  quoteId String?
  quote   Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  documentTemplateId String?
  documentTemplate   DocumentTemplate? @relation(fields: [documentTemplateId], references: [id], onDelete: SetNull)

  recurringInvoiceId String?
  recurringInvoice   RecurringInvoice? @relation(fields: [recurringInvoiceId], references: [id], onDelete: SetNull)

  lines             InvoiceLine[]
  allocations       PaymentAllocation[]
  creditNotes       CreditNote[]
  creditNoteApplications CreditNoteApplication[]
  issuanceJournalId String?             @unique
  issuanceJournal   JournalEntry?       @relation("InvoiceIssuanceJournal", fields: [issuanceJournalId], references: [id], onDelete: SetNull)
  timeEntries       TimeEntry[]
  ewayBills         EWayBill[]
  deliveryChallans  DeliveryChallan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, invoiceNumber])
  @@index([userId])
  @@index([customerId])
  @@index([status])
  @@index([recurringInvoiceId])
  @@index([documentTemplateId])
}

model DeliveryChallan {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  challanNumber String
  reference     String?
  challanDate   DateTime
  status        DeliveryChallanStatus @default(DRAFT)

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  subTotal Decimal @default(0)
  taxTotal Decimal @default(0)
  total    Decimal @default(0)
  notes    String?

  lines     DeliveryChallanLine[]
  ewayBills EWayBill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, challanNumber])
  @@index([userId])
  @@index([customerId])
  @@index([status])
  @@index([invoiceId])
}

model DeliveryChallanLine {
  id        String          @id @default(cuid())
  challanId String
  challan   DeliveryChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)

  itemId String?
  item   Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  description String
  quantity    Decimal
  rate        Decimal
  taxPercent  Decimal @default(0)

  lineNet   Decimal
  lineTax   Decimal
  lineTotal Decimal

  lineCgst Decimal @default(0)
  lineSgst Decimal @default(0)
  lineIgst Decimal @default(0)

  sortOrder Int @default(0)

  @@index([challanId])
}

model InvoiceLine {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  itemId String?
  item   Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  description String
  quantity    Decimal
  /// Unit price excluding tax
  rate       Decimal
  /// GST/VAT % on line (e.g. 18)
  taxPercent Decimal @default(0)

  lineNet  Decimal
  lineTax  Decimal
  lineTotal Decimal

  lineCgst Decimal @default(0)
  lineSgst Decimal @default(0)
  lineIgst Decimal @default(0)

  sortOrder Int @default(0)

  @@index([invoiceId])
}

model Item {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType            ItemType @default(GOODS)
  name                String
  sku                 String?
  unit                String   @default("unit")
  salesDescription    String?
  salesRate           Decimal  @default(0)
  purchaseDescription String?
  purchaseRate        Decimal  @default(0)
  sellable            Boolean  @default(true)
  purchasable         Boolean  @default(true)

  categoryId       String?
  category         ItemCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  inventoryUnitId  String?
  inventoryUnit    InventoryUnit?  @relation(fields: [inventoryUnitId], references: [id], onDelete: SetNull)
  reorderLevel     Decimal         @default(0)
  isActive         Boolean         @default(true)
  description      String?

  gstTaxPreference GstTaxPreference @default(TAXABLE)
  gstApplicable      Boolean          @default(true)
  gstRate            Decimal          @default(0)
  hsnCode            String?
  gstTaxMode         ItemGstTaxMode   @default(AUTO)
  reverseCharge      Boolean          @default(false)
  itcEligible        Boolean          @default(true)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  quoteLines          QuoteLine[]
  invoiceLines        InvoiceLine[]
  deliveryChallanLines DeliveryChallanLine[]
  purchaseReturnLines PurchaseReturnLine[]
  purchaseOrderLines  PurchaseOrderLine[]
  vendorBillLines           VendorBillLine[]
  recurringVendorBillLines  RecurringVendorBillLine[]
  recurringInvoiceLines     RecurringInvoiceLine[]
  creditNoteLines           CreditNoteLine[]
  stocks              ItemStock[]
  stockAdjustments    StockAdjustment[]

  @@index([userId])
  @@index([userId, sku])
  @@index([categoryId])
  @@index([inventoryUnitId])
}

model ItemCategory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  items     Item[]
  createdAt DateTime @default(now())

  @@unique([userId, name])
  @@index([userId])
}

model ItemStock {
  itemId      String
  warehouseId String
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity    Decimal   @default(0)

  @@id([itemId, warehouseId])
  @@index([warehouseId])
}

model JournalEntry {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryDate DateTime
  memo      String?

  referenceKind JournalReferenceKind?
  referenceId   String?

  postingStatus JournalPostingStatus @default(POSTED)
  referenceNo   String?

  /// Tally voucher cross-reference (migration / sync)
  tallyVoucherKey    String?
  tallyVoucherType   String?
  tallyVoucherNumber String?

  lines JournalLine[]

  invoiceIssuance Invoice?  @relation("InvoiceIssuanceJournal")
  paymentReceipt  Payment?  @relation("PaymentReceiptJournal")
  creditNoteEntry CreditNote? @relation("CreditNoteJournal")

  purchaseExpense PurchaseExpense?
  vendorBill      VendorBill?
  vendorPayment   VendorPayment?
  vendorCredit    VendorCredit?
  payrollRun      PayrollRun?
  depreciationEntry DepreciationEntry?
  fixedAssetDisposal FixedAsset? @relation("FixedAssetDisposalJournal")

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, entryDate])
  @@index([userId, postingStatus])
  @@index([userId, tallyVoucherKey])
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  debit  Decimal @default(0)
  credit Decimal @default(0)
  /// Line-level memo (manual journals)
  description String?

  @@index([journalEntryId])
  @@index([accountId])
}

// ---- Purchases (AP / vendors) ----

model OcrDocument {
  id     String @id @default(cuid())
