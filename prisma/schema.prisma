  @@index([userId])
}

model Transporter {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  gstin         String?
  transporterId String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ewayBills EWayBill[]

  @@index([userId])
  @@index([userId, name])
}

model EWayBill {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status       EWayBillStatus       @default(DRAFT)
  documentType EWayBillDocumentType @default(TAX_INVOICE)

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  deliveryChallanId String?
  deliveryChallan   DeliveryChallan? @relation(fields: [deliveryChallanId], references: [id], onDelete: SetNull)

  purchaseReturnId String?
  purchaseReturn   PurchaseReturn? @relation(fields: [purchaseReturnId], references: [id], onDelete: SetNull)

  sourceDocumentNumber String
  sourceDocumentDate   DateTime
  documentValue        Decimal

  ewayBillNumber String?
  generatedAt    DateTime?
  validUntil     DateTime?
  qrCodeData     String?
  apiAckNo       String?

  supplierName      String
  supplierGstin     String?
  supplierAddress   String?
  supplierStateCode String?
  supplierPincode   String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  recipientName      String
  recipientGstin     String?
  recipientAddress   String?
  recipientStateCode String?
  recipientPincode   String?

  transporterId   String?
  transporter     Transporter? @relation(fields: [transporterId], references: [id], onDelete: SetNull)
  transporterName String?
  transporterGstin String?
  transportMode   EWayTransportMode @default(ROAD)
  vehicleNumber   String?
  vehicleType     EWayVehicleType   @default(REGULAR)
  distanceKm      Int?

  placeOfSupply   String?
  supplyType      String?
  subSupplyType   String?
  transactionType String  @default("Regular")

  errorMessage         String?
  lastApiResponseJson  String?

  lines          EWayBillLine[]
  vehicleUpdates EWayBillVehicleUpdate[]
  statusHistory  EWayBillStatusHistory[]
  apiLogs        EWayBillApiLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, ewayBillNumber])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([userId, sourceDocumentNumber])
  @@index([invoiceId])
  @@index([deliveryChallanId])
  @@index([purchaseReturnId])
  @@index([customerId])
  @@index([vehicleNumber])
}

model EWayBillLine {
  id         String   @id @default(cuid())
