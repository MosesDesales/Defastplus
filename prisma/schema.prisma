  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentType String
  fileMime     String
  fileBytes    Bytes
  originalName String?

  rawText             String?
  extractedJson       String?
  fieldConfidenceJson String?
  auditLogJson        String?
  confidence          Float?
  status              String  @default("PENDING")
  errorMessage        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([userId, createdAt])
}

/// Learned vendor invoice layout patterns for faster re-extraction.
