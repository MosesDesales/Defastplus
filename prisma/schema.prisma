  taxTotal     Decimal             @default(0)
  total        Decimal             @default(0)
  memo         String?

  deliveryMode       String    @default("ORGANIZATION")
  deliveryCustomerId String?
  deliveryCustomer   Customer? @relation("PODeliveryCustomer", fields: [deliveryCustomerId], references: [id], onDelete: SetNull)
  deliverySnapshot   String?
  paymentTerms       String    @default("DUE_ON_RECEIPT")
  shipmentPreference String?
  termsAndConditions String?
  discountPercent    Decimal   @default(0)
