model SalaryComponent {
  id String @id @default(cuid())

  structureId String
  structure   SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)

  name       String
  kind       SalaryComponentKind
  amountType SalaryAmountType
  amount     Decimal @default(0)
  percentOfBasic Decimal?

  sortOrder Int @default(0)

  @@index([structureId])
}

model SalaryStructure {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String
  /// true = reusable company template (shown in the picker); false = one employee's own custom salary
  isTemplate Boolean @default(true)

  components SalaryComponent[]
  employees  Employee[]

  @@index([userId])
}

model StockAdjustment {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouseId    String
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantityDelta  Decimal
  reason         String
  createdAt      DateTime  @default(now())

  @@index([userId])
  @@index([itemId])
  @@index([warehouseId])
}

model SyncLog {
  id            String      @id @default(cuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  module       String
  status       String
  errorMessage String?
  syncedAt     DateTime    @default(now())

  @@index([integrationId])
  @@index([integrationId, syncedAt])
}

model TallyMigrationJob {
  id            String               @id @default(cuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  integrationId String?
  integration   Integration?         @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  status        TallyMigrationStatus @default(PENDING)
  sourceType    String               @default("xml_upload")
  fileName      String?
  phasesJson    String?
  statsJson     String?
  reconcileJson String?
  errorSummary  String?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  logs       TallyMigrationLog[]
  entityMaps TallyEntityMap[]
  snapshot   TallyMigrationSnapshot?

  @@index([userId, createdAt])
  @@index([integrationId])
}

model TallyMigrationLog {
  id         String            @id @default(cuid())
  jobId      String
  job        TallyMigrationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  level      String            @default("INFO")
  phase      String
  message    String
  detailJson String?
  createdAt  DateTime          @default(now())

  @@index([jobId, createdAt])
  @@index([jobId, level])
}

model TallyEntityMap {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId          String?
  job            TallyMigrationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  entityType     String
  tallyKey       String
  tallyGuid      String?
  erpModel       String
  erpId          String
  parentTallyKey String?
  metaJson       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, entityType, tallyKey])
  @@index([userId, entityType])
  @@index([userId, tallyGuid])
  @@index([jobId])
}

model TallyMigrationSnapshot {
  id         String            @id @default(cuid())
  jobId      String            @unique
  job        TallyMigrationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// Parsed summary JSON (groups, ledgers, voucher counts, TB from Tally)
  parsedJson String?
  /// SHA-256 of source for idempotent re-import detection
  sourceHash String?
  createdAt  DateTime          @default(now())
}

/// PDF / print layout presets (Zoho-style template designer).

model TeamMember {
  id String @id @default(cuid())

  ownerUserId String
  owner       User   @relation("TeamTenant", fields: [ownerUserId], references: [id], onDelete: Cascade)

  email String
  name  String

  appRoleId String?
  appRole   AppRole? @relation(fields: [appRoleId], references: [id], onDelete: SetNull)

  status TeamMemberStatus @default(INVITED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
}

model TimeEntry {
  id              String       @id @default(cuid())
  userId          String
  employeeId      String
  projectId       String?
  taskId          String?
  workTaskId      String?
  timesheetId     String?
  workDate        DateTime
  startedAt       DateTime?
  endedAt         DateTime?
  durationSeconds Int          @default(0)
  billable        Boolean      @default(true)
  notes           String?
  isRunning       Boolean      @default(false)
  isManual        Boolean      @default(false)
  invoiceId       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime
  invoice         Invoice?     @relation(fields: [invoiceId], references: [id])
  timesheet       Timesheet?   @relation(fields: [timesheetId], references: [id])
  task            TimeTask?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  workTask        WorkTask?    @relation(fields: [workTaskId], references: [id], onDelete: SetNull)
  project         TimeProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  employee        Employee     @relation(fields: [employeeId], references: [id])
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([workTaskId])
  @@index([projectId])
  @@index([timesheetId])
  @@index([userId, workDate])
  @@index([userId, employeeId])
}

model TimeProject {
  id                String              @id @default(cuid())
  userId            String
  customerId        String
  name              String
  description       String?
  startDate         DateTime?
  endDate           DateTime?
  hourlyRate        Decimal             @default(0)
  billingType       String              @default("PROJECT_HOURS")
  budgetHours       Decimal?
  status            String              @default("ACTIVE")
  progressPercent   Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  entries         TimeEntry[]
  customer          Customer            @relation(fields: [customerId], references: [id])
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  members TimeProjectMember[]
  tasks          TimeTask[]
  workTasks      WorkTask[]

  @@index([customerId])
  @@index([userId])
}

model TimeProjectMember {
  id          String      @id @default(cuid())
  projectId   String
  employeeId  String
  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project TimeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, employeeId])
  @@index([employeeId])
}

model TimeTask {
  id                 String      @id @default(cuid())
  projectId          String
  name               String
  assignedEmployeeId String?
  estimatedHours     Decimal?
  billable           Boolean     @default(true)
  priority           String      @default("MEDIUM")
  status             String      @default("OPEN")
  sortOrder          Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  entries          TimeEntry[]
  assignedEmployee           Employee?   @relation("TimeTaskAssignee", fields: [assignedEmployeeId], references: [id])
  project        TimeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([assignedEmployeeId])
  @@index([projectId])
}

model Timesheet {
  id                                  String      @id @default(cuid())
  userId                              String
  employeeId                          String
  periodStart                         DateTime
  periodEnd                           DateTime
  status                              String      @default("DRAFT")
  totalSeconds                        Int         @default(0)
  submittedAt                         DateTime?
  reviewedAt                          DateTime?
  reviewerUserId                      String?
  reviewNotes                         String?
  payrollSyncedAt                     DateTime?
  createdAt                           DateTime    @default(now())
  updatedAt                           DateTime    @updatedAt
  entries                           TimeEntry[]
  reviewerUser    User?       @relation("TimesheetReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)
  employee                            Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  user         User        @relation("TimesheetWorkspace", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, employeeId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  /// JSON array of permission keys, e.g. ["*"] or ["gst.view","hr.edit"]
  permissions  String   @default("[\"*\"]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items           Item[]
  itemCategories     ItemCategory[]
  inventoryUnits     InventoryUnit[]
  warehouses         Warehouse[]
  stockAdjustments   StockAdjustment[]
  inventorySettings  InventorySettings?
  customers       Customer[]
  quotes          Quote[]
  accounts        Account[]
  invoices        Invoice[]
  payments        Payment[]
  journalEntries  JournalEntry[]
  creditNotes        CreditNote[]
  recurringInvoices  RecurringInvoice[]

  vendors               Vendor[]
  purchaseExpenses      PurchaseExpense[]
  recurringExpenses     RecurringExpense[]
  recurringVendorBills    RecurringVendorBill[]
  purchaseOrders        PurchaseOrder[]
  vendorBills           VendorBill[]
  vendorPayments        VendorPayment[]
  vendorCredits         VendorCredit[]

  companyProfile          CompanyProfile?
  salaryStructures        SalaryStructure[]
  employees               Employee[]
  payrollRuns             PayrollRun[]
  leaveTypes              LeaveType[]
  leaveEntries            LeaveEntry[]
  appRoles                AppRole[]
  teamMembers             TeamMember[]           @relation("TeamTenant")
  gstBillReconciliations  GstBillReconciliation[]
  auditLogs               AuditLog[]
  integrations            Integration[]
  documentTemplates       DocumentTemplate[]
  ocrDocuments            OcrDocument[]
  ocrVendorTemplates      OcrVendorTemplate[]
  bankingAccounts         BankingAccount[]
  currencies              Currency[]
  fixedAssets             FixedAsset[]
  organizationSettings    OrganizationSettings?
  timeProjects            TimeProject[]
  timeEntries             TimeEntry[]
  timesheets              Timesheet[] @relation("TimesheetWorkspace")
  timesheetsReviewed      Timesheet[] @relation("TimesheetReviewer")
  documentTemplateDefaults UserDocumentTemplateDefault[]
  workTasks               WorkTask[]
  workTasksCreated        WorkTask[]           @relation("WorkTaskCreator")
  workTaskComments        WorkTaskComment[]
  workTaskAttachments     WorkTaskAttachment[]
  ewayBillSettings        EWayBillSettings?
  ewayBills               EWayBill[]
  transporters            Transporter[]
  deliveryChallans        DeliveryChallan[]
  purchaseReturns         PurchaseReturn[]
  tallyMigrationJobs      TallyMigrationJob[]
  tallyEntityMaps         TallyEntityMap[]
}

model UserDocumentTemplateDefault {
  id         String @id @default(cuid())
  userId     String
  moduleName String
  templateId String
  template DocumentTemplate @relation(fields: [templateId], references: [id])
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleName])
  @@index([templateId])
  @@index([userId])
}

model Vendor {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName    String
  companyName    String?
  salutation     String?
  firstName      String?
  lastName       String?
  email          String?
  phone          String?
  workPhoneCountryCode String @default("+91")
  workPhone            String?
  mobileCountryCode    String @default("+91")
  mobile               String?
  vendorLanguage       String @default("en")
  gstin          String?
  billingAttention String?
  billingStreet  String?
  billingCity    String?
  billingState   String?
  billingZip     String?
  billingCountry String   @default("IN")
  pan            String?
  msmeRegistered Boolean  @default(false)
  openingBalance Decimal  @default(0)
  currency       String   @default("INR")
  accountsPayableAccountId String?
  accountsPayableAccount   Account? @relation("VendorAccountsPayable", fields: [accountsPayableAccountId], references: [id], onDelete: SetNull)
  paymentTerms   String   @default("DUE_ON_RECEIPT")
  tdsAccountId   String?
  tdsAccount     Account? @relation("VendorTdsAccount", fields: [tdsAccountId], references: [id], onDelete: SetNull)
  portalEnabled  Boolean  @default(false)
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bills          VendorBill[]
  purchaseOrders PurchaseOrder[]
  payments       VendorPayment[]
  credits        VendorCredit[]
  recurringBills RecurringVendorBill[]
  purchaseExpenses PurchaseExpense[]
  recurringExpenseTemplates RecurringExpense[]

  workTasks WorkTask[]
  purchaseReturns PurchaseReturn[]

  @@index([userId])
  @@index([userId, displayName])
  @@index([accountsPayableAccountId])
  @@index([tdsAccountId])
}

model VendorBill {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorId           String
  vendor             Vendor           @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  billNumber         String
  reference          String?
  orderNumber        String?
  subject            String?
  billDate           DateTime
  dueDate            DateTime?
  paymentTerms       String           @default("DUE_ON_RECEIPT")
  accountsPayableAccountId String?
  accountsPayableAccount   Account?   @relation("VendorBillAP", fields: [accountsPayableAccountId], references: [id], onDelete: SetNull)
  notesInternal      String?
  status             VendorBillStatus @default(DRAFT)
  currency           String           @default("INR")
  exchangeRate       Decimal?
  baseTotal          Decimal?
  subTotal           Decimal          @default(0)
  taxTotal           Decimal          @default(0)
  total              Decimal          @default(0)
  withholdingType    String           @default("NONE")
  withholdingAmount  Decimal          @default(0)
  adjustmentAmount   Decimal          @default(0)
  pdfTemplate        String           @default("Standard Template")
  purchaseOrderId    String?
  purchaseOrder      PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  lines                VendorBillLine[]
  paymentAllocations   VendorPaymentAllocation[]
  creditApplications   VendorCreditApplication[]
  purchaseReturns      PurchaseReturn[]

  journalEntryId String?       @unique
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, billNumber])
  @@index([userId])
  @@index([vendorId])
  @@index([status])
  @@index([accountsPayableAccountId])

  gstReconciliation GstBillReconciliation?
}

model VendorBillLine {
  id               String    @id @default(cuid())
  billId           String
  bill             VendorBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  itemId           String?
  item             Item?     @relation(fields: [itemId], references: [id], onDelete: SetNull)
  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  description      String
  quantity         Decimal
  rate             Decimal
  discountPercent  Decimal   @default(0)
  taxPercent       Decimal   @default(0)
  lineNet          Decimal
  lineTax          Decimal
  lineTotal        Decimal
  lineCgst         Decimal @default(0)
  lineSgst         Decimal @default(0)
  lineIgst         Decimal @default(0)
  expenseAccountId String?
  expenseAccount   Account?  @relation("VendorBillLineExpense", fields: [expenseAccountId], references: [id], onDelete: SetNull)
  sortOrder        Int       @default(0)

  @@index([billId])
  @@index([customerId])
}

model PurchaseReturn {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  returnNumber String
  reference    String?
  returnDate   DateTime
  status       PurchaseReturnStatus @default(DRAFT)

  vendorBillId String?
  vendorBill   VendorBill? @relation(fields: [vendorBillId], references: [id], onDelete: SetNull)

  reason   String?
  subTotal Decimal @default(0)
  taxTotal Decimal @default(0)
  total    Decimal @default(0)

  lines     PurchaseReturnLine[]
  ewayBills EWayBill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, returnNumber])
  @@index([userId])
  @@index([vendorId])
  @@index([status])
  @@index([vendorBillId])
}

model PurchaseReturnLine {
  id       String         @id @default(cuid())
  returnId String
  purchaseReturn PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  itemId String?
  item   Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  description String
  quantity    Decimal
  rate        Decimal
  taxPercent  Decimal @default(0)

  lineNet   Decimal
  lineTax   Decimal
  lineTotal Decimal

  lineCgst Decimal @default(0)
  lineSgst Decimal @default(0)
  lineIgst Decimal @default(0)

  sortOrder Int @default(0)

  @@index([returnId])
}

model VendorCredit {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorId         String
  vendor           Vendor             @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  creditNumber     String
  issueDate        DateTime
  amount           Decimal
  amountApplied    Decimal            @default(0)
  reason           String?
  status           VendorCreditStatus @default(OPEN)
  expenseAccountId String
  expenseAccount   Account            @relation("VendorCreditExpenseAccount", fields: [expenseAccountId], references: [id], onDelete: Restrict)

  applications VendorCreditApplication[]

  journalEntryId String?       @unique
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, creditNumber])
  @@index([userId])
  @@index([vendorId])
}

model VendorCreditApplication {
  id       String       @id @default(cuid())
  creditId String
  credit   VendorCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)
  billId   String
  bill     VendorBill   @relation(fields: [billId], references: [id], onDelete: Restrict)
  amount   Decimal

  @@index([creditId])
  @@index([billId])
}

model VendorPayment {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorId        String
  vendor          Vendor        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  paymentNumber   String
  paymentDate     DateTime
  mode            PaymentMode
  reference       String?
  amount          Decimal
  memo            String?
  bankAccountId   String
  bankAccount     Account       @relation("VendorPaymentBankAccount", fields: [bankAccountId], references: [id], onDelete: Restrict)

  allocations VendorPaymentAllocation[]

  journalEntryId String?       @unique
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, paymentNumber])
  @@index([userId])
  @@index([vendorId])
}

model VendorPaymentAllocation {
  id        String        @id @default(cuid())
  paymentId String
  payment   VendorPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  billId    String
  bill      VendorBill    @relation(fields: [billId], references: [id], onDelete: Restrict)
  amount    Decimal

  @@index([paymentId])
  @@index([billId])
}

model Warehouse {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  code        String?
  isDefault   Boolean  @default(false)
  stocks      ItemStock[]
  adjustments StockAdjustment[]
  createdAt   DateTime @default(now())

  @@index([userId])
}

// --- Work tasks (team task management) ---

enum WorkTaskStatus {
  OPEN
  IN_PROGRESS
  WAITING_REVIEW
  COMPLETED
  CANCELLED
}

enum WorkTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkSubtaskStatus {
  OPEN
  COMPLETED
}

model WorkTask {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdByUserId    String?
  createdByUser      User?            @relation("WorkTaskCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  title              String
  description        String?
  assignedEmployeeId String?
  assignedEmployee   Employee?        @relation("WorkTaskAssignee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  timeProjectId      String?
  timeProject        TimeProject?     @relation(fields: [timeProjectId], references: [id], onDelete: SetNull)
  customerId         String?
  customer           Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vendorId           String?
  vendor             Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  priority           WorkTaskPriority @default(MEDIUM)
  status             WorkTaskStatus   @default(OPEN)
  startDate          DateTime?
  dueDate            DateTime?
  estimatedHours     Decimal?
  actualSeconds      Int              @default(0)
  progressPercent    Int              @default(0)
  billable           Boolean          @default(false)
  tags               String?
  recurrenceRule     String?
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  subtasks     WorkSubtask[]
  comments     WorkTaskComment[]
  attachments  WorkTaskAttachment[]
  timeEntries  TimeEntry[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, assignedEmployeeId])
  @@index([userId, dueDate])
  @@index([timeProjectId])
  @@index([customerId])
  @@index([vendorId])
}

model WorkSubtask {
  id        String            @id @default(cuid())
  taskId    String
  task      WorkTask          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title     String
  status    WorkSubtaskStatus @default(OPEN)
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([taskId])
}

model WorkTaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([taskId])
}

model WorkTaskAttachment {
  id               String   @id @default(cuid())
  taskId           String
  task             WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedByUserId String?
  uploadedByUser   User?    @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  fileName         String
  fileUrl          String
  mimeType         String?
  createdAt        DateTime @default(now())

  @@index([taskId])
}
